# ============================================================================
# BookLeaf Publishing — Author Support & Communication Portal
# Environment Configuration Example (.env.example)
# Copy this file to .env.local and fill in your values.
# ============================================================================

# 1. Database Connection
# Provide a MongoDB Atlas or local MongoDB connection string.
# If left empty in local development, the app automatically falls back to
# the built-in Mongoose-schema-validated Persistent JSON Store (.data/bookleaf-db.json)
# pre-seeded from data/bookleaf_sample_data.json for instant zero-config evaluation.
MONGODB_URI=mongodb://ansarisaifuddin732_db_user:IlJWqp2zb6ZsBlFH@ac-xnxb9sv-shard-00-00.h9njhyh.mongodb.net:27017,ac-xnxb9sv-shard-00-01.h9njhyh.mongodb.net:27017,ac-xnxb9sv-shard-00-02.h9njhyh.mongodb.net:27017/?ssl=true&replicaSet=atlas-qj9lmu-shard-0&authSource=admin

# 2. Redis Distributed In-Memory Cache (Upstash Redis)
# Provides sub-millisecond query speedups and distributed rate limiting.
# Falls back to direct database execution if omitted.
REDIS_URL="rediss://default:gQAAAAAAAmsqAAIgcDI1NDM5NWYwYWRlN2Y0YTE0ODkzYzE4YThjN2FlODU5ZA@adjusted-hermit-158506.upstash.io:6379"

# 2. Authentication & Session Security
# Secret key used to sign HTTP-only JWT session cookies (minimum 32 characters recommended)
SESSION_SECRET=bookleaf-dev-session-secret-change-in-production-2026

# Development/Demo Default Passwords (used when seeding accounts from bookleaf_sample_data.json)
DEMO_AUTHOR_PASSWORD=author123
DEMO_ADMIN_EMAIL=admin@bookleafpub.com
DEMO_ADMIN_PASSWORD=admin123

# 3. AI Support Engine (Google Gemini API)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# Never expose this key to the client/browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=8000

# 4. ImageKit.io Cloud Media Storage (For Defective Copy Photos & Ticket Attachments)
# When configured, ticket attachments upload directly to ImageKit CDN (/bookleaf-tickets).
# If left empty locally, attachments gracefully store safe metadata & local preview URLs.

IMAGEKIT_PUBLIC_KEY=public_42PJ3Dfu5r83X7iIyJ3F8qthmcM=
IMAGEKIT_PRIVATE_KEY=private_BpwVXRnAcd+LNbq5sUGrggxvLfU=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/4eqyb4rwe
# 5. Application URL & Upload Configuration
APP_URL=http://localhost:3000
MAX_ATTACHMENT_SIZE_MB=5

# 6. Nodemailer SMTP Configuration (Transactional Activity Emails)
# Used for login alerts, Razorpay payment receipts, ticket updates & milestones.
# In local development or if left unconfigured, the app uses an interactive
# Mailbox Simulator with real-time UI preview and stored activity log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BookLeaf Publishing <support@bookleafpub.com>"
