# ============================================================================
# BookLeaf Publishing — Author Support & Communication Portal
# Environment Configuration Example (.env.example)
# Copy this file to .env.local and fill in your values.
# ============================================================================

# 1. Database Connection
# Provide a MongoDB Atlas or local MongoDB connection string.
# If left empty in local development, the app automatically falls back to
# the built-in Mongoose-schema-validated Persistent JSON Store (.data/bookleaf-db.json)
# pre-seeded from data/bookleaf_sample_data.json for instant zero-config evaluation.
MONGODB_URI=

# 2. Authentication & Session Security
# Secret key used to sign HTTP-only JWT session cookies (minimum 32 characters recommended)
SESSION_SECRET=bookleaf-dev-session-secret-change-in-production-2026

# Development/Demo Default Passwords (used when seeding accounts from bookleaf_sample_data.json)
DEMO_AUTHOR_PASSWORD=author123
DEMO_ADMIN_EMAIL=admin@bookleafpub.com
DEMO_ADMIN_PASSWORD=admin123

# 3. AI Support Engine (Google Gemini API)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# Never expose this key to the client/browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=8000

# 4. ImageKit.io Cloud Media Storage (For Defective Copy Photos & Ticket Attachments)
# When configured, ticket attachments upload directly to ImageKit CDN (/bookleaf-tickets).
# If left empty locally, attachments gracefully store safe metadata & local preview URLs.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# 5. Application URL & Upload Configuration
APP_URL=http://localhost:3000
MAX_ATTACHMENT_SIZE_MB=5
